# Environment Variables for Microfinance Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/microfinance

# ─── Auth ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Blockchain Network Selector ──────────────────
# Options: 'ganache' (local dev) | 'amoy' (Polygon Amoy testnet)
BLOCKCHAIN_NETWORK=ganache

# ─── Ganache (Local Dev) ──────────────────────────
GANACHE_RPC_URL=http://127.0.0.1:7545

# ─── Polygon Amoy Testnet ─────────────────────────
# Public RPC (free, sometimes slow):
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Recommended: Alchemy free tier (more reliable):
# POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ─── Platform Wallet ──────────────────────────────
# Used to sign blockchain audit trail transactions
# Export from MetaMask: Account > ... > Account Details > Export Private Key
# WARNING: Use a DEDICATED wallet, NOT your main MetaMask
# WARNING: NEVER commit this file with real keys to Git!
PLATFORM_WALLET_ADDRESS=0xYourWalletAddressHere
PLATFORM_WALLET_PRIVATE_KEY=YourPrivateKeyHereWithout0xPrefix
